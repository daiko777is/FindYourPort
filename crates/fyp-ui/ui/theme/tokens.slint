// Design Tokens for Find Your Port
// Based on UI/UX Design Document (03_UIUX_Design_FindYourPort.md)

export global DesignTokens {
    // Colors - Dark Mode (Default)
    in-out property <color> bg_primary: #0f1117;
    in-out property <color> bg_secondary: #1a1d27;
    in-out property <color> bg_tertiary: #232630;
    in-out property <color> bg_elevated: #2a2e3b;
    in-out property <color> text_primary: #e8e8e8;
    in-out property <color> text_secondary: #8b8f98;
    in-out property <color> text_muted: #5a5e66;
    in-out property <color> accent_green: #4ade80;
    in-out property <color> accent_orange: #fb923c;
    in-out property <color> accent_red: #f87171;
    in-out property <color> accent_blue: #60a5fa;
    in-out property <color> accent_purple: #a78bfa;
    in-out property <color> border_default: #2a2e3b;
    in-out property <color> border_focus: #60a5fa;

    // Spacing
    in-out property <length> space_xs: 4px;
    in-out property <length> space_sm: 8px;
    in-out property <length> space_md: 16px;
    in-out property <length> space_lg: 24px;
    in-out property <length> space_xl: 32px;

    // Border Radius
    in-out property <length> radius_sm: 4px;
    in-out property <length> radius_md: 6px;
    in-out property <length> radius_lg: 8px;
    in-out property <length> radius_xl: 12px;

    // Shadows
    in-out property <color> shadow_modal: #00000066;
    in-out property <color> shadow_elevated: #00000033;

    // Typography
    in-out property <string> font_ui: "Inter";
    in-out property <string> font_mono: "JetBrains Mono";
}

// Light mode variant
export global LightTokens {
    in-out property <color> bg_primary: #f8f9fa;
    in-out property <color> bg_secondary: #ffffff;
    in-out property <color> bg_tertiary: #e9ecef;
    in-out property <color> bg_elevated: #ffffff;
    in-out property <color> text_primary: #212529;
    in-out property <color> text_secondary: #6c757d;
    in-out property <color> text_muted: #adb5bd;
    in-out property <color> border_default: #dee2e6;
    in-out property <color> border_focus: #3b82f6;
}