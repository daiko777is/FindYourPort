// Confirm Kill Modal
import { DesignTokens } from "../theme/tokens.slint";
import { FypButton } from "../components/fyp-button.slint";

export component ConfirmKillModal inherits Rectangle {
    in property <string> process_name;
    in property <string> pid;
    in property <string> port;
    in property <string> protocol;

    callback confirmed();
    callback cancelled();

    width: 400px;
    height: 200px;
    background: DesignTokens.bg_elevated;
    border-radius: DesignTokens.radius_lg;

    VerticalLayout {
        padding: DesignTokens.space_lg;
        spacing: DesignTokens.space_md;

        Text {
            text: "You are about to terminate:";
            font-family: DesignTokens.font_ui;
            font-size: 13px;
            color: DesignTokens.text_secondary;
        }

        Rectangle {
            background: DesignTokens.bg_secondary;
            border-radius: DesignTokens.radius_md;

            VerticalLayout { spacing: 6px;
                padding: DesignTokens.space_md;
                HorizontalLayout { spacing: DesignTokens.space_sm;
                    Rectangle { width: 24px; height: 24px; background: DesignTokens.accent_blue; border-radius: 4px; }
                    VerticalLayout { spacing: 2px;
                        Text { text: root.process_name; font-family: DesignTokens.font_ui; font-size: 14px; font-weight: 600; color: DesignTokens.text_primary; }
                        Text { text: "PID: " + root.pid; font-family: DesignTokens.font_mono; font-size: 11px; color: DesignTokens.text_secondary; }
                    }
                }
                Text { text: "Listening on port " + root.port + " (" + root.protocol + ")"; font-family: DesignTokens.font_mono; font-size: 12px; color: DesignTokens.text_secondary; }
            }
        }

        Text {
            text: "⚠️ This action cannot be undone.";
            font-family: DesignTokens.font_ui;
            font-size: 11px;
            color: DesignTokens.accent_orange;
        }

        HorizontalLayout {
            spacing: DesignTokens.space_md;
            alignment: end;

            FypButton {
                text: "Cancel";
                width: 100px; height: 36px;
                font_size: 13px;
                clicked => { root.cancelled(); }
            }

            FypButton {
                text: "Kill Process";
                width: 120px; height: 36px;
                font_size: 13px;
                danger: true;
                clicked => { root.confirmed(); }
            }
        }
    }
}